{
  "name": "etric-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local eTRiS browser automation MCP server",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "login": "node dist/index.js --login",
    "save-login": "node dist/index.js --save-login",
    "stop": "node dist/index.js --stop",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "playwright": "^1.64.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
