{
  "name": "etric-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local eTRiS browser automation MCP server",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/ossmalaysia/etric-mcp.git" },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "login": "node dist/index.js --login",
    "save-login": "node dist/index.js --save-login",
    "stop": "node dist/index.js --stop",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:read": "npm run build && node scripts/test-read.mjs",
    "audit": "npm audit --audit-level=low && npm audit signatures",
    "check:repo": "node scripts/check-repo.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "playwright": "1.64.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "7.0.2"
  },
  "overrides": { "eventsource-parser": "3.1.0" }
}
